# Copy to backend/.env and fill in. backend/.env is gitignored; keys never go in the frontend.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional, paid: better place search, autocomplete and review samples
GOOGLE_PLACES_API_KEY=
# Optional Square sales import used by Ruth's advisor; sandbox returns test data
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
# Optional; otherwise the first active Square location is used for stock alerts
SQUARE_LOCATION_ID=
# Optional: the Lovable app's Supabase project. When both are set, store.py also writes spots, spot_scores,
# picks and alerts there in Lovable's shapes (scripts/sync_to_supabase.py), and Ruth's monitor uses her tables.
# Server key only (service_role JWT or sb_secret_…): never in the frontend or lovable-app/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Or put an sb_secret_ key here instead of SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SECRET_KEY=
# 1 = serve fixtures from backend/demo/ so the stage demo never depends on live scraping
DEMO_MODE=0
# Optional model overrides
# CLAUDE_MODEL=claude-opus-5-5      # Kneha's POST /api/recommendations
# SCORING_MODEL=claude-sonnet-5-5   # crumbs review scoring
