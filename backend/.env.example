# Copy to backend/.env and fill in. backend/.env is gitignored; keys never go in the frontend.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional, paid: better place search, autocomplete and review samples
GOOGLE_PLACES_API_KEY=
# Optional Square sales import used by Ruth's advisor; sandbox returns test data
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
# 1 = serve fixtures from backend/demo/ so the stage demo never depends on live scraping
DEMO_MODE=0
# Optional model overrides
# CLAUDE_MODEL=claude-opus-5-5      # Kneha's POST /api/recommendations
# SCORING_MODEL=claude-sonnet-5-5   # crumbs review scoring
